install.packages("fst")
tar_load(res_tib)
inner_join(
res_tib |>
filter(padj < 0.10) |>
summarise(`padj < 0.10` = n(), .by = contrast),
res_tib |>
filter(padj < 0.05) |>
summarise(`padj < 0.05` = n(), .by = contrast),
by = join_by(contrast)) |>
inner_join(
res_tib |>
filter(padj < 0.05, abs(log2FoldChange) >= 0.5) |>
summarise(`padj < 0.05 & abs(lFC) >= 0.5` = n(), .by = contrast),
