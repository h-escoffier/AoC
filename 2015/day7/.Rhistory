#| label: setup
#| include: false
library(tidyverse)
library(targets)
library(DESeq2)
library(patchwork)
library(EnrichmentBrowser)
library(gtExtras)
library(RColorBrewer)
library(readxl)
library(fgsea)
library(glmnet)
library(ggplot2)
library(ggrepel)
library(ggbreak)
library(AnnotationDbi)
library(fst)
library("org.Hs.eg.db")
source("R/deseq2.R")
# bifag::cluster_mount("iris")
options(max.print = .Machine$integer.max, scipen = 999, stringsAsFactors = F, dplyr.summarise.inform = F)
#Set seed
set.seed(655321)
tar_load(res_tib)
inner_join(
res_tib |>
filter(padj < 0.10) |>
summarise(`padj < 0.10` = n(), .by = contrast),
res_tib |>
filter(padj < 0.05) |>
summarise(`padj < 0.05` = n(), .by = contrast),
by = join_by(contrast)) |>
inner_join(
res_tib |>
filter(padj < 0.05, abs(log2FoldChange) >= 0.5) |>
summarise(`padj < 0.05 & abs(lFC) >= 0.5` = n(), .by = contrast),
by = join_by(contrast)) |>
arrange(desc(`padj < 0.05 & abs(lFC) >= 0.5`))
# write.csv(res_tib, 'hnscc_degs/res_tib_doi.csv', row.names = F, quote = F)
tar_load(res_tib)
res_tib |>
filter(contrast == "recurrence_Y_vs_N") |>
dplyr::select(-contrast, -lfcSE, -gene_id, -pvalue) |>
relocate(gene_name, .before = 1L) |>
filter(padj < 0.05, abs(log2FoldChange) >= 0.5 ) |>
arrange(padj) |>
slice_head(n = 30) |>
gt() |>
tab_style(
style = cell_text(
font = c("Comic Sansa", "Menloa", default_fonts())
), locations = cells_body(columns = everything())
) |>
fmt_number(columns = c(baseMean, log2FoldChange),
decimals = 3) |>
fmt_scientific(
columns = padj,
decimals = 2) |>
data_color(columns = padj, reverse = TRUE,
palette = "viridis") |>
data_color(columns = log2FoldChange,
palette = colorRampPalette(c("blue", "white", "red"))(n = 100)) |>
gt_theme_guardian()
# write.csv(res_tib, 'hnscc_degs/res_tib.csv', row.names = F, quote = F)
# Load top_genes
res_df <- res_tib |>
filter(contrast == "recurrence_Y_vs_N")
# write.csv(top_genes, '100SAllG.csv', row.names = F, quote = T)
#| fig-align: center
#| fig.width: 10
#| fig.height: 7
res_df <- res_df |>
mutate(gene_type = case_when(log2FoldChange >= 0.5 & padj <= 0.05 ~ "Up",
log2FoldChange <= -0.5 & padj <= 0.05 ~ "Down",
TRUE ~ "Not changed"))
cols <- c("Up" = "#E64B35FF", "Down" = "#4DBBD5FF", "Not changed" = "grey")
degs_genes <- res_df |>
filter(padj < 0.05) |>
filter(abs(log2FoldChange) >= 0.5)
vln_plt <- res_df |>
ggplot(aes(x = log2FoldChange,
y = -log10(padj))) +
# POINTS
geom_point(aes(colour = gene_type),
alpha = 1,
shape = 16,
size = 1) +
geom_point(data = degs_genes,
aes(fill = gene_type),
shape = 21,
size = 2.5,
stroke = 0,
show.legend = F) +
# LINES
geom_hline(yintercept = -log10(0.05),
linetype = "dashed") +
geom_vline(xintercept = c(-0.5, 0.5),
linetype = "dashed") +
# COLORS
scale_color_manual(values = cols) +
# DEGS LABELS
geom_text_repel(data = degs_genes,
aes(label = gene_name),
box.padding = 1,
point.padding = 0.7,
segment.color = "grey50",
segment.size = 0.6,
segment.alpha = 0.5,
size = 4,
force = 3,
force_pull = 0.5,
max.overlaps = Inf) +
# AXES
scale_x_continuous(limits = c(-2, 2)) +
scale_y_continuous(limits = c(-0, 2.5)) +
# scale_y_break(c(3, 7), ticklabels=c(7, 7.5)) +
# AXES LABELS
labs(title = NULL,
x = "log2FC",
y = "-log10(Adjusted P-value)",
colour = "") +
# THEME
theme_minimal() +
theme(plot.title = element_text(size = 15, face = "bold"),
legend.text = element_text(size = 13),
legend.title = element_text(size = 14),
axis.text = element_text(size = 13),
axis.title = element_text(size = 15))
vln_plt
#| fig-align: center
#| fig.width: 10
#| fig.height: 7
vln_plt <- res_df |>
ggplot(aes(x = log2FoldChange,
y = -log10(padj))
) +
geom_point(aes(colour = gene_type),
alpha = 1,
shape = 16,
size = 1) +
geom_point(data = degs_genes,
aes(fill = gene_type),
shape = 21,
size = 2.5,
stroke = 0,
show.legend = FALSE) +
scale_color_manual(values = cols) +
scale_fill_manual(values = cols) +
geom_hline(yintercept = -log10(0.05), linetype = "dashed") +
geom_vline(xintercept = c(-0.5, 0.5), linetype = "dashed") +
geom_text_repel(data = degs_genes30,
aes(label = gene_name),
box.padding = 1,
point.padding = 0.7,
segment.color = "grey50",
segment.size = 0.6,
segment.alpha = 0.5,
size = 4,
force = 3,
force_pull = 0.5,
max.overlaps = Inf) +
scale_x_continuous(limits = c(-2, 2)) +
scale_y_continuous(limits = c(0, 2.5)) +
labs(title = NULL,
x = "log2FC",
y = "-log10(Adjusted P-value)",
colour = "") +
guides(colour = guide_legend(override.aes = list(size = 4))) +  # Enlarges legend dots
theme_minimal() +
theme(
plot.title = element_text(size = 16, face = "bold"),
legend.text = element_text(size = 13),
legend.title = element_text(size = 14),
axis.text = element_text(size = 13),
axis.title = element_text(size = 15),
plot.background = element_rect(fill = "white", color = NA),   # White plot background
panel.background = element_rect(fill = "white", color = NA),  # White panel background
legend.background = element_rect(fill = "white", color = NA)  # White legend background
)
View(degs_genes)
#| fig-align: center
#| fig.width: 10
#| fig.height: 7
