install.packages("ggbeeswarm")
#| label: setup
#| include: false
library(tidyverse)
library(targets)
library(DESeq2)
library(patchwork)
library(EnrichmentBrowser)
library(gtExtras)
library(RColorBrewer)
library(readxl)
library(fgsea)
library(glmnet)
library(ggplot2)
library(ggrepel)
library(ggbreak)
library(ggbeeswarm)
library(AnnotationDbi)
library(fst)
library("org.Hs.eg.db")
source("R/deseq2.R")
# bifag::cluster_mount("iris")
options(max.print = .Machine$integer.max, scipen = 999, stringsAsFactors = F, dplyr.summarise.inform = F)
#Set seed
set.seed(655321)
tar_load(dds)
plotCounts(dds, gene = 'ENSG00000286911', normalized = TRUE,
intgroup = c("recurrence"),
returnData = TRUE) |>
ggplot(aes(x = recurrence, y = count)) +
geom_violin() +
ggbeeswarm::geom_quasirandom(dodge.width = .8) +
theme_bw(14) +
theme(legend.position = "top") +
labs(title = paste("Gene:", 'ENSG00000286911'),
x = "Rec",
y = "Normalized counts")
plotCounts(dds, gene = 'ENSG00000285761', normalized = TRUE,
intgroup = c("recurrence"),
returnData = TRUE) |>
ggplot(aes(x = recurrence, y = count)) +
geom_violin() +
ggbeeswarm::geom_quasirandom(dodge.width = .8) +
theme_bw(14) +
theme(legend.position = "top") +
labs(title = paste("Gene:", 'ENSG00000285761'),
x = "Rec",
y = "Normalized counts")
plotCounts(dds, gene = 'ENSG00000104522', normalized = TRUE,
intgroup = c("recurrence"),
returnData = TRUE) |>
ggplot(aes(x = recurrence, y = count)) +
geom_violin() +
ggbeeswarm::geom_quasirandom(dodge.width = .8) +
theme_bw(14) +
theme(legend.position = "top") +
labs(title = paste("Gene:", 'ENSG00000104522'),
x = "Rec",
y = "Normalized counts")
# is there duplicate
any(duplicated(res_df$gene_name))
# which one ?
dup_gene_names <- res_df |>
dplyr::filter(duplicated(gene_name)) |>
dplyr::pull(gene_name)
# filter duplicated
res_df_filter <- res_df |>
# Sort so that the highest absolute values of the log2 fold change are at the top
dplyr::arrange(dplyr::desc(abs(log2FoldChange))) |>
# Filter out the duplicated rows using `dplyr::distinct()`
dplyr::distinct(gene_name, .keep_all = TRUE)
any(duplicated(res_df_filter$gene_name))
# ranking
rec_vs_no <- res_df_filter |>
mutate(sign_p_value = -log10(pvalue) * sign(log2FoldChange)) |>
arrange(desc(sign_p_value))
res_gsea <- rec_vs_no |>
dplyr::select(gene_name, sign_p_value) |>
na.omit()
ranks <- deframe(res_gsea)
head(ranks, 20)
# load pathway
pathways.hallmark <- gmtPathways("gsea/h.all.v2023.2.Hs.entrez.gmt.txt")
# pathways.hallmark |>
#   head() |>
#   lapply(head)
fgseaRes <- fgsea(pathways=pathways.hallmark, stats=ranks)
fgseaResTidy <- fgseaRes |>
as_tibble() |>
arrange(desc(NES))
#| fig-align: center
#| fig.width: 17
#| fig.height: 12
fgseaResTidy$significance <- ifelse(fgseaResTidy$padj <= 0.05, "FDR < 0.05", "FDR > 0.05")
# ggplot(fgseaResTidy, aes(reorder(pathway, NES), NES)) +
#   # color with a gradient according to the p-value
#   geom_col(aes(fill = pval), width = 0.5) +
#   coord_flip() +
#   labs(x="Pathway", y="Normalized Enrichment Score",
#        title="Hallmark pathways NES from GSEA - Recurrence_Y_vs_N") +
#   theme_minimal()
enrich_plot <- ggplot(fgseaResTidy, aes(reorder(pathway, NES), NES)) +
geom_col(aes(fill = significance), width = 0.8) +
coord_flip() +
labs(x = "HALLMARK Gene Sets ",
y = "Normalized Enrichment Score",
title = "",
fill = "") +
scale_fill_manual(values = c("FDR < 0.05" = "#E64B35FF", "FDR > 0.05" = "#4DBBD5FF")) +  # Binarized color scheme
# scale_fill_viridis(option = "C", direction = -1, begin = 0.1, end = 0.9) +
geom_text(aes(label = ifelse(NES > 0, round(NES, 2), "")),
hjust = -0.2, color = "black") +
geom_text(aes(label = ifelse(NES < 0, round(NES, 2), "")),
hjust = 1.1, color = "black") +
theme_minimal() +
theme(plot.title = element_text(size = 16, face = "bold"),
legend.text = element_text(size = 13),
legend.title = element_text(size = 14),
axis.text = element_text(size = 13),
axis.title = element_text(size = 15),
legend.position = "right",
plot.background = element_rect(fill = "white", color = NA),   # White plot background
panel.background = element_rect(fill = "white", color = NA),  # White panel background
legend.background = element_rect(fill = "white", color = NA))
enrich_plot
ggsave("figures/figs5.tiff",
plot = enrich_plot,
width = 17, height = 12, dpi = 800, units = "in", compression = "lzw")
#| fig-align: center
#| fig.width: 12
#| fig.height: 10
topPathwaysUp <- fgseaRes[ES > 0][head(order(pval), n=10), pathway]
topPathwaysDown <- fgseaRes[ES < 0][head(order(pval), n=10), pathway]
topPathways <- c(topPathwaysUp, rev(topPathwaysDown))
plotGseaTable(pathways.hallmark[topPathways], ranks, fgseaRes,
gseaParam = 0.5)
#| fig-align: center
#| fig.width: 10
#| fig.height: 6
enrichment_data <- plotEnrichment(pathways.hallmark$HALLMARK_HYPOXIA, ranks)
# Convert to data frame for ggplot2
enrichment_df <- data.frame(
x = enrichment_data$data$rank,
runningScore = enrichment_data$data$ES
)
max_y <- max(enrichment_df$runningScore)
max_x <- enrichment_df$x[which.max(enrichment_df$runningScore)]
min_y <- min(enrichment_df$runningScore)
hypo_plot <- ggplot(enrichment_df, aes(x = x, y = runningScore)) +
# LINES
geom_vline(xintercept = max_x, linetype = "dashed", color = "red", size = 1.3) +
geom_line(color = "green", size = 1.2) +
geom_segment(data = enrichment_df, aes(x = x, xend = x, y = -(0.07*max_y), yend = (0.07*max_y)), color = "black", size = 0.1) +
geom_hline(yintercept = 0, color = "black") +
# AXES LABELS
labs(title = "HALLMARK_HYPOXIA",
x = "Position in the Ranked List of Genes",
y = "Enrichment Score") +
# THEM
theme_minimal() +
theme(
plot.title = element_text(size = 16, hjust = 0.5, face = "bold"),
legend.text = element_text(size = 13),
legend.title = element_text(size = 14),
axis.text = element_text(size = 13),
axis.title = element_text(size = 15),
plot.background = element_rect(fill = "white", color = NA),   # White plot background
panel.background = element_rect(fill = "white", color = NA),  # White panel background
legend.background = element_rect(fill = "white", color = NA))
hypo_plot
ggsave("figures/figs7.tiff",
plot = hypo_plot,
width = 10, height = 6, dpi = 800, units = "in", compression = "lzw")
#| fig-align: center
#| fig.width: 10
#| fig.height: 6
enrichment_data <- plotEnrichment(pathways.hallmark$HALLMARK_EPITHELIAL_MESENCHYMAL_TRANSITION, ranks)
